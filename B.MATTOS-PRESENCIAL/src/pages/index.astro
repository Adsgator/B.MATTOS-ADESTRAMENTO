---
import Layout from '../components/global/Layout.astro';
import HeroSection        from '../sections/HeroSection.astro';
import SobreSection       from '../sections/SobreSection.astro';
import ServicosSection    from '../sections/ServicosSection.astro';
import DiferenciaisSection from '../sections/DiferenciaisSection.astro';
import PrecosSection      from '../sections/PrecosSection.astro';
import FAQSection         from '../sections/FAQSection.astro';
import InstagramSection   from '../sections/InstagramSection.astro';
import CTAFinalSection    from '../sections/CTAFinalSection.astro';
---

<Layout
  title="Adestramento e Mentoria Canina Presencial - Bea Mattos K9 SJC"
  description="Treinamento e mentoria presencial para donos e cães em São José dos Campos. Desenvolva autonomia e construa uma convivência equilibrada com seu cão. Mais de 6 anos de experiência."
  ogTitle="Bea Mattos Adestramento — Atendimento Presencial em São José dos Campos"
  ogDescription="Atendimento presencial individualizado para você entender seu cão, aplicar as estratégias certas e construir uma convivência equilibrada, sem depender para sempre de um treinador."
  canonical="https://presencial.abeak9adestramento.com.br"
>
  <HeroSection />
  <SobreSection />
  <ServicosSection />
  <DiferenciaisSection />
  <PrecosSection />
  <FAQSection />
  <InstagramSection />
  <CTAFinalSection />
</Layout>
