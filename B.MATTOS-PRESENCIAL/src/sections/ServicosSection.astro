---
import SectionHeader from '../components/global/SectionHeader.astro';
import FeatureCard from '../components/global/FeatureCard.astro';
import Button from '../components/global/Button.astro';

// Ícones personalizados da marca — vêm com fill="black" e dimensões fixas;
// normaliza para currentColor (o card aplica o terracota) e tamanho fluido
import iconCaoPuxaGuia from '../assets/icons/cao-puxa-guia.svg?raw';
import iconReatividade from '../assets/icons/reatividade.svg?raw';
import iconAnsiedade from '../assets/icons/ansiedade-adaptacao.svg?raw';
import iconSocializacao from '../assets/icons/socializacao.svg?raw';
import iconComunicacao from '../assets/icons/comunicacao.svg?raw';
import iconChegadaFilhotes from '../assets/icons/chegada-filhotes.svg?raw';
import iconCaesTrabalho from '../assets/icons/caes-trabalho.svg?raw';
import iconGuardaProtecao from '../assets/icons/guarda-protecao.svg?raw';
import iconConsultoriaRaca from '../assets/icons/consultoria-raca.svg?raw';

const normalizarIcone = (svg: string) =>
  svg
    .replace(/fill="black"/g, 'fill="currentColor"')
    .replace(/<svg([^>]*?)\swidth="\d+"\sheight="\d+"/, '<svg$1');

const whatsappHref = 'https://wa.me/5511918952921?text=Ol%C3%A1%21%20Vi%20o%20site%20e%20quero%20saber%20mais.';

const itens = [
  {
    title: 'Cão que puxa na guia',
    description: 'Ensino você a conduzir seu cão com segurança, sem puxões e sem estresse para os dois.',
    svg: normalizarIcone(iconCaoPuxaGuia),
  },
  {
    title: 'Reatividade com pessoas ou outros cães',
    description: 'Estratégias práticas para reduzir reações de medo ou agressividade do seu cão.',
    svg: normalizarIcone(iconReatividade),
  },
  {
    title: 'Ansiedade e dificuldades de adaptação',
    description: 'Trabalho a segurança emocional do seu cão para reduzir a ansiedade no dia a dia.',
    svg: normalizarIcone(iconAnsiedade),
  },
  {
    title: 'Socialização',
    description: 'Desenvolvo a capacidade do seu cão de conviver bem com pessoas e outros animais.',
    svg: normalizarIcone(iconSocializacao),
  },
  {
    title: 'Comunicação entre você e o seu cão',
    description: 'Ajusto a forma como vocês se comunicam para o seu cão realmente te entender.',
    svg: normalizarIcone(iconComunicacao),
  },
  {
    title: 'Preparação para a chegada de filhotes',
    description: 'Organizo a rotina do seu cão antes da chegada de um bebê ou outro pet.',
    svg: normalizarIcone(iconChegadaFilhotes),
  },
  {
    title: 'Desenvolvimento de cães de trabalho',
    description: 'Treinamento técnico que respeita o perfil e o propósito de cada cão de trabalho.',
    svg: normalizarIcone(iconCaesTrabalho),
  },
  {
    title: 'Guarda e proteção esportiva',
    description: 'Trabalho técnico de guarda e proteção, com segurança em cada etapa.',
    svg: normalizarIcone(iconGuardaProtecao),
  },
  {
    title: 'Consultoria para escolha de raça e perfil de cão',
    description: 'Te ajudo a escolher o cão certo para a sua rotina, antes mesmo de ele chegar.',
    svg: normalizarIcone(iconConsultoriaRaca),
  },
];
---

<section id="servicos" class="py-16 sm:py-24 lg:py-32 bg-surface" aria-label="Serviços de adestramento presencial">
  <div class="container-content">

    <SectionHeader
      label="Serviços"
      title="Adestramento presencial pensado para a sua rotina"
      subtitle="Cada cão tem uma história, uma genética, um ambiente e objetivos diferentes. Por isso os atendimentos são personalizados para funcionar de verdade no dia a dia da sua família."
    />

    <!-- Card de destaque -->
    <div class="bg-dark text-bg rounded-card p-8 sm:p-10 lg:p-12 mb-8 sm:mb-10 relative overflow-hidden gsap-stagger-item">
      <div class="glow-orb w-40 h-40 sm:w-64 sm:h-64 -top-10 -right-10 sm:-top-16 sm:-right-16 animate-glow-pulse" aria-hidden="true"></div>
      <div class="relative z-10 max-w-2xl">
        <h3 class="font-display text-2xl sm:text-display-md text-bg mb-4">Obediência básica e avançada</h3>
        <p class="font-sans text-body-md text-bg/70 leading-relaxed">
          Atendimentos presenciais personalizados para desenvolver soluções reais e aplicáveis à rotina de cada
          família, respeitando as necessidades do cão e de quem o conduz. Abrange desde problemas de convivência
          até objetivos avançados como obediência, controle e desenvolvimento de habilidades específicas,
          capacitando o dono a compreender e conduzir seu próprio cão.
        </p>
      </div>
    </div>

    <!-- Grid de serviços específicos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-10 sm:mb-14">
      {itens.map((item, i) => (
        <FeatureCard svg={item.svg} title={item.title} description={item.description} index={i} />
      ))}
    </div>

    <div class="flex justify-center">
      <Button
        label="Quero um atendimento personalizado"
        href={whatsappHref}
        variant="gold"
        trackingId="servicos-cta"
        section="servicos"
      />
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced || typeof gsap === 'undefined') return;

    gsap.from('#servicos .gsap-stagger-item', {
      scrollTrigger: { trigger: '#servicos', start: 'top 70%' },
      opacity: 0,
      y: 16,
      duration: 0.45,
      ease: 'power3.out',
      stagger: 0.05,
    });
  });
</script>
