---
interface Props {
  svg:         string;    // markup SVG completo (inline, com fill="currentColor")
  title?:      string;
  description: string;
  dark?:       boolean;
  index?:      number;    // para stagger GSAP
}

const { svg, title, description, dark = false, index = 0 } = Astro.props;
---

<div
  class:list={[
    'gsap-stagger-item tilt-card',
    'flex items-start gap-4 p-6 rounded-card',
    dark
      ? 'bg-dark-lighter border border-white/10 hover:border-white/20'
      : 'bg-white border border-surface',
  ]}
  data-index={index}
>
  <!-- Ícone monocromático — herda a cor via currentColor -->
  <div
    class:list={[
      'flex-shrink-0 w-11 h-11 rounded-pill flex items-center justify-center text-primary',
      dark ? 'bg-primary/20' : 'bg-primary/10',
    ]}
  >
    <span class="w-6 h-6 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={svg} />
  </div>

  <!-- Conteúdo -->
  <div>
    {title && (
      <h3 class:list={['font-display text-body-md mb-1', dark ? 'text-white' : 'text-text']}>
        {title}
      </h3>
    )}
    <p class:list={['font-sans text-body-sm', dark ? 'text-white/70' : 'text-muted']}>
      {description}
    </p>
  </div>
</div>
